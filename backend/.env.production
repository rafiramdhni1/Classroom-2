# ============================================
# SMK TKJ Akademik - Production Environment
# ============================================
# Copy this file to .env.production and fill in the values
# ============================================

# Server
PORT=5000
NODE_ENV=production

# MongoDB (Docker internal)
MONGODB_URI=mongodb://mongodb:27017/smk_akademik

# JWT (CHANGE THIS to a random string!)
JWT_SECRET=smk-tkj-akademik-production-2024-change-me
JWT_EXPIRES_IN=7d

# Google OAuth2 (Classroom API)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN.com/api/auth/google/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# Admin WhatsApp
ADMIN_PHONE=628XXXXXXXXXX

# Frontend URL (YOUR DOMAIN!)
FRONTEND_URL=https://YOUR_DOMAIN.com

# n8n Webhook Secret (CHANGE THIS!)
N8N_SECRET=your-n8n-secret-change-me
